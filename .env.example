# ==============================================================================
# ReboundFit Environment Variables
# Copy this file to .env.local and populate with your Supabase project credentials.
# Also configure these under Vercel -> Project Settings -> Environment Variables.
# ==============================================================================

# Supabase Project URL (e.g. https://abcdefghijklm.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase Anonymous Public API Key (found in Supabase Dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here
